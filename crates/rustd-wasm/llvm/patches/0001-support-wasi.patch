diff --git a/llvm/lib/Support/WASI/Program.inc b/llvm/lib/Support/WASI/Program.inc
new file mode 100644
index 000000000..38f653fac
--- /dev/null
+++ b/llvm/lib/Support/WASI/Program.inc
@@ -0,0 +1,70 @@
+//===- Program.inc - WASI: there are no other programs --------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/Support/Errc.h"
+#include "llvm/Support/FileSystem.h"
+
+namespace llvm {
+using namespace sys;
+
+ProcessInfo::ProcessInfo() : Pid(0), ReturnCode(0) {}
+
+ErrorOr<std::string> sys::findProgramByName(StringRef Name,
+                                            ArrayRef<StringRef> Paths) {
+  return errc::no_such_file_or_directory;
+}
+
+static bool Execute(ProcessInfo &PI, StringRef Program,
+                    ArrayRef<StringRef> Args,
+                    std::optional<ArrayRef<StringRef>> Env,
+                    ArrayRef<std::optional<StringRef>> Redirects,
+                    unsigned MemoryLimit, std::string *ErrMsg,
+                    BitVector *AffinityMask, bool DetachProcess) {
+  if (ErrMsg)
+    *ErrMsg = "WASI cannot start a program";
+  return false;
+}
+
+ProcessInfo sys::Wait(const ProcessInfo &PI,
+                      std::optional<unsigned> SecondsToWait,
+                      std::string *ErrMsg,
+                      std::optional<ProcessStatistics> *ProcStat,
+                      bool Polling) {
+  if (ErrMsg)
+    *ErrMsg = "WASI cannot wait for a program";
+  ProcessInfo Result;
+  Result.ReturnCode = -1;
+  return Result;
+}
+
+std::error_code sys::ChangeStdinMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+std::error_code sys::ChangeStdoutMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+std::error_code sys::ChangeStdinToBinary() { return std::error_code(); }
+std::error_code sys::ChangeStdoutToBinary() { return std::error_code(); }
+
+std::error_code sys::writeFileWithEncoding(StringRef FileName,
+                                           StringRef Contents,
+                                           WindowsEncodingMethod Encoding) {
+  std::error_code EC;
+  raw_fd_ostream OS(FileName, EC, fs::OF_TextWithCRLF);
+  if (EC)
+    return EC;
+  OS << Contents;
+  if (OS.has_error())
+    return make_error_code(errc::io_error);
+  return EC;
+}
+
+bool sys::commandLineFitsWithinSystemLimits(StringRef Program,
+                                            ArrayRef<StringRef> Args) {
+  return true;
+}
+} // namespace llvm
