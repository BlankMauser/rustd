+"#,
+        expect![[r#"
+macro_rules! nest {
+    ($name:ident ($dol:tt) => ([$($arg:ident)*] $($body:tt)+)) => {
+        macro_rules! $name { ($($dol $arg:expr),*) => { $($body)+ } }
+    };
+    ($name:ident ($dol:tt) => ([$($arg:ident)*] $($body:tt)+) $p1:ident $($p2:ident)*) => {
