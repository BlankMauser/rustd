diff --git a/Cargo.toml b/Cargo.toml
index 9caf8dcfe1ada9127177e743761a84412e0b203b..cf2797a81a73aed0e9d1a6ffb59afcfce9d5ae5e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,6 +1,8 @@
 [workspace]
 members = ["xtask/", "lib/*", "lib/ungrammar/ungrammar2json", "crates/*"]
-exclude = ["crates/proc-macro-srv/proc-macro-test/imp"]
+# `rustd-wasm` turns on a feature of `hir-ty` that swaps the code generator's output, which
+# must not be unified into a build of the native crates.
+exclude = ["crates/proc-macro-srv/proc-macro-test/imp", "crates/rustd-wasm"]
 resolver = "2"
 
 [workspace.package]
@@ -35,6 +37,8 @@ inherits = "release"
 debug = 2
 
 [patch.'crates-io']
+# rustc's layout code, from the tag of the stable in `harness/toolchain`.
+ra-ap-rustc_abi = { path = "lib/rustc_abi" }
 # rowan = { path = "../rowan" }
 
 # line-index = { path = "lib/line-index" }
@@ -155,6 +159,7 @@ tracing-subscriber = { version = "0.3.20", default-features = false, features =
     "tracing-log",
 ] }
 triomphe = { version = "0.1.14", default-features = false, features = ["std"] }
+unicode-width = "0.2.2"
 url = "2.5.4"
 xshell = "0.2.7"
 thin-vec = "0.2.16"
